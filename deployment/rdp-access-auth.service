[Unit]
Description=Private RDP access authentication portal
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/rdp-access-auth
StateDirectory=rdp-access-auth
StateDirectoryMode=0700
LoadCredential=settings.json:/etc/rdp-access-auth/portal-settings.json
Environment=RDP_AUTH_CONFIG=%d/settings.json
Environment=RDP_AUTH_STATE=/var/lib/rdp-access-auth/state.sqlite3
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/rdp-access-auth/.venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:18089 --timeout 30 --access-logfile /dev/null --error-logfile - --log-level warning portal:app
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=multi-user.target
