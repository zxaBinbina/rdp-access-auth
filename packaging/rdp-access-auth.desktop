[Desktop Entry]
Type=Application
Name=RDP Access Auth
Name[zh_CN]=RDP Access Auth 部署向导
Comment=Configure and deploy the RDP authentication portal
Comment[zh_CN]=在浏览器中配置并部署远程桌面认证入口
Exec=rdp-auth deploy --gui
Icon=rdp-access-auth
Terminal=true
Categories=Network;Settings;
Actions=Manage;

[Desktop Action Manage]
Name=Manage installed service
Name[zh_CN]=管理已部署服务
Exec=sudo /usr/bin/rdp-auth --profile system gui
